# Obligatorias en ejecución con base de datos
DATABASE_URL=postgresql://radio:radio_local@localhost:5432/radio_campus
ADMIN_PASSWORD=cambia-esta-contrasena
SESSION_SECRET=genera-al-menos-32-caracteres-aleatorios

# URL pública; si se omite, el QR usa el host de la petición
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Pusher Channels (opcional; sin estas variables se usa polling)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Gemini TTS y Vercel Blob (opcionales)
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
BLOB_READ_WRITE_TOKEN=

# Cron: secreto recomendado para invocar /api/cron/avanzar
CRON_SECRET=
