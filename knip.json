{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,route}.ts",
    "src/app/**/{page,layout,route}.tsx",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "next.config.ts",
    "drizzle.config.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "tests/**/*.ts"],
  "ignoreDependencies": [
    "@google/genai",
    "@vercel/blob",
    "pusher",
    "pusher-js",
    "qrcode.react"
  ]
}
